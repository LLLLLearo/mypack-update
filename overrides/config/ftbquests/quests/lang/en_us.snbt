{
  "chapter_group.53679B3D8B9D2B7A.title": "基地上新：从小工厂到太空",
  "chapter.3DF5B918E2C6AC42.title": "先学会玩：地图不用重开",
  "task.30E79773785FFCB8.title": "开始新的玩法",
  "quest.6F9A0ECC301DCD3B.title": "老基地，准备上新！",
  "quest.6F9A0ECC301DCD3B.quest_desc": [
    "从工业章开始做第一台机器，也可以先去种田、钓鱼、拍照或探险。原来的基地和物资都能接着用。"
    "大部分物品任务只检查持有，不收走材料；需要提交的任务会另作说明。手动勾选的任务，做完后再确认。"
    "带星号的挑战可以抽取饰品，具体次数见各任务说明。"
  ],
  "task.66C025F4DAF9FDCB.title": "已确认队伍与分工",
  "quest.682A0497134EB9D2.title": "这活儿可以分着干",
  "quest.682A0497134EB9D2.quest_desc": [
    "打开物品栏里的队伍入口，创建或加入同一个队伍，共享任务进度。"
    "种田、加工、找矿和探险可以分头做，材料带回基地一起用。"
    "出发去太空时，每个人都要准备自己的航天服、氧气和返程物资。"
  ],
  "quest.62513B00DC1715B8.title": "不会做？先学会查",
  "quest.62513B00DC1715B8.quest_desc": [
    "鼠标移到物品上，按 G 查制作配方，按 H 查用途。整合包修改过的配方也能查到。"
    "按手册键（默认 H）打开「矿物科技」，在「操作教程」里查机器用法。机器不工作时，检查电量、核心、插件和输出槽。"
    "鼠标指向航天物品，长按 N 可查看中文平板说明；打开平板也能按目录浏览。"
  ],
  "task.77B04DF85BA49901.title": "了解老地图的资源入口",
  "quest.7712A75FBF0A7A00.title": "地图跑太大，也能开工",
  "quest.7712A75FBF0A7A00.quest_desc": [
    "旧区块不会补生成新矿。缺镍时，可在工作台用 4 铁锭＋4 铜锭＋1 红石合成 1 镍锭。"
    "有了碎片锻造炉，再加工粗铁并离心提取镍。这条副产物配方需要粗铁，铁塔产出的铁锭不能代替。"
    "找油器可以检查旧区块的地下储油量。有油再放抽油机，抽干后不会补满。"
  ],
  "chapter.75F574E2162026C1.title": "工业开工：一台一台搭起来",
  "quest.5C6FDBEFAC6EB5E9.title": "先借一点镍，工厂以后还",
  "quest.5C6FDBEFAC6EB5E9.quest_desc": [
    "工作台：4 铁锭＋4 铜锭＋1 红石→1 镍锭。这个配方耗料较多，先做够线圈、电机和初期机器使用。"
    "有了磁通门和碎片锻造炉，再通过粗矿加工补充镍。铁塔产出的铁锭不能代替粗铁取得副产物。"
    "旧矿区没有工业矿物时，可以去新生成的矿区或末地新地形找矿。"
  ],
  "quest.10FD17F1D618159F.title": "铁塔申请转岗：炼钢厂",
  "quest.10FD17F1D618159F.quest_desc": [
    "先在工作台用 2 铁锭＋2 煤或木炭合成 1 钢锭，准备 8 个用于起步。"
    "铸造炉建好后，改用 1 铁锭＋1 煤粉炼 1 钢锭，能省下一半铁。工业机器和航天设备都要用钢。"
    "后面扩建机器、管线和升级件时还会继续消耗，按需要补货即可。"
  ],
  "quest.3A54D204C1A69A90.title": "铜线绕起来",
  "quest.3A54D204C1A69A90.quest_desc": [
    "工作台用 6 镍锭＋3 钢锭制作 4 个磁线圈，发电机和电机都会用到。"
    "装配机的配方更省材料：1 钢锭＋2 镍锭＋1 铜锭，一批产出 6 个。装配机建好后可以改用这个配方。"
  ],
  "quest.3F3E33E08B310222.title": "电机：以后到处都要用",
  "quest.3F3E33E08B310222.quest_desc": [
    "工作台：1 镍锭＋4 钢锭＋2 磁线圈→1 电机。铸造炉、装配机和第一台离心机都需要它。"
    "装配机：1 镍锭＋1 钢锭＋2 磁线圈→2 电机。"
    "火箭发动机也需要电机，批量生产时记得多留一些。"
  ],
  "quest.0E843AD01AD7C2C2.title": "金子和红石的新工作",
  "quest.0E843AD01AD7C2C2.quest_desc": [
    "工作台用 2 金锭＋2 红石制作 1 琥珀金锭，用于接线和制作第一台铸造炉。"
    "铸造炉建好后，1 金锭＋1 红石就能炼成 1 琥珀金锭。"
  ],
  "quest.6D9B32BB23451100.title": "先让电量条动一下",
  "quest.6D9B32BB23451100.quest_desc": [
    "制作基础燃煤发电机、电缆和机器核心。给发电机放煤或木炭，连接机器；右击机器查看核心位置，再手持核心补齐。"
    "燃煤机输出 32 RF/t。粉碎机需要 24，离心机需要 48，铸造炉和装配机各需 96，碎片锻造炉需要 192 RF/t。多台同时开工时，用电量要相加。"
    "加工时电量一直见底，就需要增加电源、储能，或分批开机器。之后还可以换用 256 RF/t 的燃油发电机。"
    "工业电源也能给航天机器供电。"
  ],
  "quest.66B19322CC53ED39.title": "骨头进去，骨粉出来",
  "quest.66B19322CC53ED39.quest_desc": [
    "给粉碎机安装核心、接电。1 骨头能粉碎成 6 骨粉，煤或木炭能粉碎成煤粉。"
    "煤粉离心后得到碳纤维；石英粉碎后得到石英粉，接下来做硅和流体管道要用。"
    "粗铁提取镍的工艺用的是碎片锻造炉，不是这台粉碎机。"
  ],
  "quest.66F209F1FB50E1D1.title": "粗铁还能带点私货",
  "quest.66F209F1FB50E1D1.quest_desc": [
    "做出磁通门后，制作碎片锻造炉。粗铁加工会产出铁团块、铁团块碎片和镍团块碎片，9 个同类碎片可合成 1 个团块。"
    "团块送进离心机，继续合并粉尘并熔炼。这里需要粗铁，铁锭不能取得同样的副产物。"
    "先给每种产物准备箱子，再接管道，免得某一种堆满后整台机器停工。"
  ],
  "quest.3E506A01164750A7.title": "别急着加水，先离心",
  "quest.3E506A01164750A7.quest_desc": [
    "第一台离心机可用工作台替代配方制作：3 玻璃瓶＋2 铜锭＋2 铁块＋2 电机，不需要处理器。"
    "把煤或木炭粉碎成煤粉，再用干式离心取得碳纤维。此时不用加水，也不需要碎片锻造炉、磁通门或铂。"
    "硅和流体管道做好后，再安装流体插件。水管接机器本体，插件用于开启流体加工。"
    "铁团块和镍团块的加工，等碎片锻造炉建好后再做。"
  ],
  "quest.5A60FF9A6DDF8D43.title": "从「缺镍」到「顺便攒镍」",
  "quest.5A60FF9A6DDF8D43.quest_desc": [
    "用碎片锻造炉加工粗铁，将碎片合并成团块，再送进离心机，取得镍团块。"
    "粗镍也能加工成镍团块，并带来铂副产物。材料充足后，可以少用耗铁铜的应急镍配方。"
    "记得收走所有副产物，箱子满了也会影响主产物加工。"
  ],
  "quest.2117EB491694D561.title": "镍后面，还藏着铂",
  "quest.2117EB491694D561.quest_desc": [
    "镍团块放进干式离心机，得到小撮铂粉。熔炼成铂粒后，9 粒合成 1 铂锭。"
    "有了矿物加工线，还可以将 3 粗铂依次碎片锻造、合并、离心、晶体铸造，得到 6 铂锭和 7 辐水晶。"
    "第一批铂可以直接熔炼粗铂取得，不必等这条加工线建好。剩下的粗矿留着增产。"
  ],
  "quest.15EF995CFECC534F.title": "把合金的事交给炉子",
  "quest.15EF995CFECC534F.quest_desc": [
    "给铸造炉接电、安装核心。1 铁锭＋1 煤粉可炼成 1 钢锭；1 金锭＋1 红石可炼成 1 琥珀金锭。"
    "1 钻石＋1 镍锭可炼成 1 精镍锭，比工作台的 2 钻石＋2 镍锭省料。粗生物聚合物和铁还能炼成有机钢。"
    "天境材料也能用：1 神炼重力晶矿＋1 镍锭→2 精镍锭。"
  ],
  "quest.431AD81106D32B40.title": "两台合成器，换一个装配厂",
  "quest.431AD81106D32B40.quest_desc": [
    "准备 2 个原版合成器，制作装配机。放好后接电、安装核心，试着批量制作磁线圈或电机。"
    "装配机有 4 个输入槽，可以堆叠材料，每次按配方扣除。输出槽也要留出空间。"
    "处理器、透镜、超导体都能在这里制作；蜜脾和生物质还可以加工成黏液球。"
  ],
  "quest.63790237330AE293.title": "塑料也能从田里长出来",
  "quest.63790237330AE293.quest_desc": [
    "4 小麦合成浓缩小麦。在装有流体插件的离心机中，浓缩小麦＋四分之一桶水→1 粗生物聚合物。"
    "粗生物聚合物＋半桶水→1 塑料；粗生物聚合物＋铁锭则能在铸造炉炼成有机钢。"
    "聚合物两边都要用，分开留料。亚麻方块也有替代配方，按 G 查询。"
  ],
  "quest.089C71E80768C659.title": "科技小关卡：材料真能续上吗",
  "quest.089C71E80768C659.quest_desc": [
    "装配机：1 处理器＋1 辐水晶＋1 骨块＋1 铂锭→1 磁通门。9 骨粉可合成骨块，骨头经粉碎机加工能多出一些骨粉。"
    "首批铂直接熔炼粗铂取得；首份辐水晶用早期激光采集成熟紫水晶簇。两样材料都能在碎片锻造炉之前取得。"
    "磁通门做好后，就能制作碎片锻造炉，开始加工粗铁、粗镍和粗铂。"
  ],
  "quest.58EB6D7FF081ED84.title": "给自己装点新本事",
  "quest.58EB6D7FF081ED84.quest_desc": [
    "强化应用设备可以给角色添加能力。打开界面，查看研究需要的材料和电量，选一项强化试试。"
    "外骨骼每件需要外骨骼模板，胸甲另需武神金属。基础喷气背包也需要武神金属，高级飞行装备还需要火星材料。"
    "植入体、外骨骼和喷气背包属于装备支线，合成工业核心不需要提交它们。水下呼吸、抗火等强化也不能代替航天服和氧气。"
  ],
  "quest.6B48B0D2B1FBB0A7.title": "一口油井，喂两家工厂",
  "quest.6B48B0D2B1FBB0A7.quest_desc": [
    "原油有两种用途：送航天炼油机制作火箭燃料，或送工业精炼厂分馏出重油、石脑油和酸。不同流体分罐存放。"
    "精炼厂需要 9 个机器核心。第二、第三路流体要从顶部另放的精炼室模块输出，制作主机时消耗的模块不算在内。"
    "接好后先检查石脑油能否进入储罐，再接下游机器。"
    "跨模组输油时，可用航天管道送进工业储罐，再接工业管道。火箭使用航天模组的火箭燃料。"
  ],
  "task.15ED9368AD492811.title": "已运行一条持续生产线",
  "quest.2B4B41DE4713414B.title": "工厂开了，别只当摆设",
  "quest.2B4B41DE4713414B.quest_desc": [
    "接好供料、加工、出料和储存，让一条生产线连续运行。可以先生产一批杜拉或计算部件，看看是哪一步最慢。"
    "动力房、矿物车间、农业加工间、化工厂和激光大厅可以分开建设。钢和铜按扩建设备的用量准备。"
    "仓库、铁匠铺若满足 MCA 蓝图要求，也能计入生活核心；工业机器不能替代蓝图指定的功能方块。"
    "终极任务栏有强化碳板、杜拉和超级 AI 的备料任务，只检查持有，不消耗材料。"
  ],
  "quest.2711D5E4B21AD9A6.title": "站远一点，激光要来了",
  "quest.2711D5E4B21AD9A6.quest_desc": [
    "先在装配机制作末影透镜，需要精镍、碳纤维和末影化合物；末影化合物可由末影珍珠粉碎取得。"
    "激光本体不需要磁通门，目标指示器需要处理器。做好后安装核心、接电，用指示器设置方向。"
    "对准成熟紫水晶簇，可以取得辐水晶。留出一条空光路，避开建筑和储物箱。"
    "这台激光之后还能给原子炉供能，详细用法见工业手册。"
  ],
  "quest.298747C0CAD57A99.title": "让无人机接班",
  "quest.298747C0CAD57A99.quest_desc": [
    "制作无人机港，按工业手册设置收发两端，先运一批普通材料测试。"
    "可以用它把矿物车间的金属送到装配间，或把化工厂的板材送到激光大厅。短距离用漏斗或管道也很方便。"
    "无人机属于可选物流，不影响工业核心的合成。"
  ],
  "quest.6DD3FEB09303F2D2.title": "电不够了？再考虑大工程",
  "quest.6DD3FEB09303F2D2.quest_desc": [
    "核反应堆控制器需要 3 个火星塔尔石锭，探索火星后才能制作。登月、到达火星和合成工业核心都不强制使用核电。"
    "工厂用电增加后，再考虑建设。电站功率提高时，也要检查线缆和设备入口能否接收。"
    "搭建前阅读手册里的结构、冷却和运行说明。核电、冷却及粒子加速器不受普通加工降速影响。"
  ],
  "chapter.4EBC2CDF15AB9BB7.title": "分工联动：每个人都有订单",
  "quest.23A51F95E8710CC8.title": "钓鱼佬也能支援工厂",
  "quest.23A51F95E8710CC8.quest_desc": [
    "1 个潮汐鱼骨可合成 2 骨粉，能给农场施肥，也能制作黑白摄影胶卷。"
    "工业需要的骨块可用骨粉合成。钓鱼剩下的鱼骨正好能派上用场。"
  ],
  "quest.3F3D7DAE91633BEA.title": "小麦田获得工业订单",
  "quest.3F3D7DAE91633BEA.quest_desc": [
    "4 小麦可合成 1 浓缩小麦，拿一批送去加工。"
    "粉碎后得到生物质，加水离心则得到粗生物聚合物。两种材料用途不同，按需要分别生产。"
  ],
  "quest.5CFFB6078030B56C.title": "别把晚饭全喂给机器",
  "quest.5CFFB6078030B56C.quest_desc": [
    "粉碎机或碎片锻造炉：1 浓缩小麦→16 生物质。亚麻方块也能在碎片锻造炉中加工成生物质。"
    "生物质用于制作黏液球和燃料。接自动供料前设好白名单，免得把食品、收藏鱼和树苗也送进机器。"
  ],
  "quest.6DD5CF6FEADC7F47.title": "亚麻：种一次，养三条线",
  "quest.6DD5CF6FEADC7F47.quest_desc": [
    "亚麻可制作绳索、船帆，也能加工成生物质和粗生物聚合物。收获时留够种子。"
    "亚麻适合春季种植，其他季节可以预留原料，或改用小麦供应工业加工。"
  ],
  "quest.6C046310BBF0FE03.title": "种田玩家也能造钢",
  "quest.6C046310BBF0FE03.quest_desc": [
    "浓缩小麦＋四分之一桶水，离心得到粗生物聚合物；用亚麻方块的替代配方需要半桶水。"
    "粗生物聚合物＋铁锭，可在铸造炉炼成生物钢。多种配方允许它替代普通钢。"
    "工业版火箭发动机和处理器明确需要生物钢，记得单独备料。"
  ],
  "quest.0C9A1CA664A6B803.title": "机器帮忙种，农场帮忙造机器",
  "quest.0C9A1CA664A6B803.quest_desc": [
    "施肥机消耗电和水催长作物，加入肥料还能加强效果。"
    "先在一小块地上测试催长、收割和复种。季节变化与双格高作物可能影响运行，确认后再扩大农田。"
    "初期的小农场就能供料，可以以后再补全自动收割。"
  ],
  "quest.00AE8D1D3625EEDD.title": "出海不用先薅一群羊",
  "quest.00AE8D1D3625EEDD.quest_desc": [
    "工作台：5 亚麻＋2 原木＋2 绳索→1 船帆。原来的羊毛配方也能用。"
    "做好船帆后，可以用船运农产品、矿物或远征补给。"
  ],
  "task.3BFB65502145BEE7.title": "已完成一条实际运输路线",
  "quest.5A505EB2F9156EA3.title": "给运输线一个正经工作",
  "quest.5A505EB2F9156EA3.quest_desc": [
    "用船或马车，把一批农产品、矿物或设备从产地送到工厂或基地。"
    "两头各准备一个装卸箱，跑通一次运输即可。道路和码头可以之后再修。"
  ],
  "quest.0035B2AC3495B08B.title": "天堂的宝藏，现在还能供工厂",
  "quest.0035B2AC3495B08B.quest_desc": [
    "进入天境，已有门户可以直接使用。"
    "气凝胶可用于大氧气罐；神炼重力晶矿和武神金属锭可以加工高级合金。带回基地后，交给做工业的队友也能用。"
  ],
  "quest.373FEEF8D71B8879.title": "天境出产：轻一点的氧气罐",
  "quest.373FEEF8D71B8879.quest_desc": [
    "装配机：2 钢锭＋1 气凝胶＋1 塑料片→1 大氧气罐。"
    "容量与原配方相同，气凝胶替代了部分钢材。做好后还要充氧。"
  ],
  "quest.0B768B8E252BB43D.title": "重力石不用只做装备",
  "quest.0B768B8E252BB43D.quest_desc": [
    "铸造炉：1 神炼重力晶矿＋1 镍锭→2 精镍锭。"
    "钻石和镍的原配方也能用，按手里的材料选择。"
  ],
  "quest.3328FE4D8C0ACF6A.title": "重复宝藏，也能换新用途",
  "quest.3328FE4D8C0ACF6A.quest_desc": [
    "重复的武神装备可以熔炼成武神金属锭，回收前确认好哪些要留用。"
    "外骨骼模板：4 有机钢＋2 戴斯锭＋2 处理器＋1 神炼重力晶矿→1 模板。外骨骼每件用 1 模板，只有胸甲另需 1 武神金属锭；基础喷气背包仍需 1 武神金属锭。"
    "武神金属锭和铂锭还能在铸造炉炼成杜拉锭，材料可以由队友分头收集。"
  ],
  "quest.31F35FDC9509C0BA.title": "总得有人记录这帮人",
  "quest.31F35FDC9509C0BA.quest_desc": [
    "制作相机，潜行使用打开配置界面，装入胶卷。普通使用进入取景，按画面提示拍摄。"
    "装配机可用塑料片＋金锭＋火药＋青金石制作彩色胶卷。拍过的胶卷留好，里面存着照片。"
    "在配方查看器中查询已拍胶卷的用途，按步骤冲洗、打印。挑战章里还有摄影任务。"
  ],
  "task.10E2563653A16916.title": "照片已冲洗并展示",
  "quest.6EE9F2F015FAE015.title": "★ 让大家出现在同一张照片里",
  "quest.6EE9F2F015FAE015.quest_desc": [
    "拍摄至少 3 张照片：一张集体照、一张生产现场、一张出行照片。冲洗、打印后，在基地展示或放进相册。"
    "整理好后手动勾选。每人可领取 1 次随机饰品奖励，每人限领一次。"
  ],
  "chapter.54EC90037B758F6C.title": "航天远征：记得把人带回来",
  "quest.36452F4AF255A900.title": "别找矿了，炉里就能做",
  "quest.36452F4AF255A900.quest_desc": [
    "铁锭放进熔炉得到重金属锭，铁块放进熔炉得到重金属板，铁塔产物也能用。"
    "重金属、钢和生物钢在配方里各有用途，分别备料。"
  ],
  "quest.70A6AECA10797413.title": "找油：看区块，不看地面颜色",
  "quest.70A6AECA10797413.quest_desc": [
    "手持找油器右击地面，查看当前区块的储油量，有油再放抽油机。"
    "旧区块也能在加入航天模组后首次读取时生成储油记录。并非每个区块都有油，抽干后也不会补满。"
  ],
  "quest.229E909606FEC7A9.title": "有油、有电，才会开泵",
  "quest.229E909606FEC7A9.quest_desc": [
    "把抽油机放在有油的区块，接上工业电源。观察电量和出油情况。"
    "原油接入储罐，留出输出空间。跨模组输油时，让航天管道向工业储罐推送。"
  ],
  "quest.7E3B10D68A613396.title": "汽车柴油不能直接送火箭",
  "quest.7E3B10D68A613396.quest_desc": [
    "给航天炼油机接电、输入航天原油，可以得到火箭燃料和柴油。按界面接好桶或管道。"
    "两种产物分罐储存：柴油可以供工业使用，火箭要加航天模组的火箭燃料。"
  ],
  "quest.245D8966EA40006D.title": "先把呼吸这件事安排好",
  "quest.245D8966EA40006D.quest_desc": [
    "给水分离机接电、加水，机器会分离出氢气和氧气。按界面槽位收集。"
    "将氧气装进罐子，再用于航天装备。空罐需要充氧后才能用。"
    "出发前，每个人都检查一次自己的氧气储备。"
  ],
  "quest.38C6D67CAD39C055.title": "同队可以共享任务，肺不行",
  "quest.38C6D67CAD39C055.quest_desc": [
    "做齐并穿上航天头盔、胸甲、护腿、靴子，给氧气罐或装备充好氧。"
    "任务只检查是否持有这些装备，不检查穿戴和剩余氧气，起飞前需要自行确认。"
    "原版水下呼吸、天境抗火装备和工业强化不能直接替代星球所需的防护。"
  ],
  "quest.2151B4E594BE36FA.title": "把异星小屋变成能呼吸的家",
  "quest.2151B4E594BE36FA.quest_desc": [
    "给氧气分配器供电，再用充满的氧气罐或对应方式供气。在小房间里测试可呼吸范围。"
    "外出探索时仍要带个人航天服和备用氧气。"
  ],
  "quest.4CC3F8849EF335B8.title": "发射场不必很豪华",
  "quest.4CC3F8849EF335B8.quest_desc": [
    "制作火箭装配站和 9 个发射台，将发射台铺成 3×3。"
    "装配站用于组合火箭零件。多人共用发射场时，检查发射台的所有者和共享权限。"
  ],
  "quest.03A2F18571361971.title": "科技小关卡：工厂收到登月订单",
  "quest.03A2F18571361971.quest_desc": [
    "火箭发动机需要电机、蜂蜜块和生物材料，手工配方还会用到粗生物聚合物，完整摆法查配方查看器。"
    "装配机配方：电机＋重金属板＋蜂蜜块＋生物钢→1 发动机，比手工路线省重金属。"
    "蜂蜜可以用现有储备，也可搭自动蜂场。侦测器触发朝向蜂巢的发射器，用玻璃瓶取蜜；手工收蜜前放好营火。分拣满蜜瓶时，给发射器留下空瓶。"
    "发动机做好后，再准备 4 个尾翼和鼻锥。"
  ],
  "quest.32D8F08E591C6600.title": "火箭终于有了，不急着点火",
  "quest.32D8F08E591C6600.quest_desc": [
    "把零件放进火箭装配站，完成后右击 3×3 发射台放置火箭。"
    "按界面加好燃料，检查目的地和个人装备。基础微型火箭一次只能载 1 个实体，多人出发要分批或准备更多火箭。"
  ],
  "task.0432FD7CA0331FAF.title": "全员检查完成，可以启程",
  "quest.1C9493FD7539D04F.title": "起飞前，全员点名",
  "quest.1C9493FD7539D04F.quest_desc": [
    "出发前逐人检查：航天服穿齐、氧气充足，带好工具、备用氧气和返程物资。"
    "给火箭加正确的燃料，记下出发坐标并确认返程方法。"
    "本包开启了太空罐头限制，用真空装罐机制作食物罐。只带原版食物，在太空可能无法进食。"
    "检查完后手动勾选；任务不会自动检查每个人的装备。"
  ],
  "quest.614C2D62DB333112.title": "月球到了，先记得怎么回家",
  "quest.614C2D62DB333112.quest_desc": [
    "乘降落器着陆时按空格减速。落地后先检查氧气和返程物资，再去找戴斯等资源。"
    "粗戴斯可带回工业粉碎机，1 个加工成 2 戴斯锭。"
  ],
  "quest.0495FCBEF61E30E0.title": "登月的收获，送回老工厂",
  "quest.0495FCBEF61E30E0.quest_desc": [
    "粗戴斯可以直接熔炼，也可以送进工业粉碎机，1 粗戴斯加工成 2 戴斯锭。"
    "这个增产配方只接受粗矿，成品锭不能重复加工。记得给升级设备和燃料储备留料。"
  ],
  "task.1B635FA3B5F81FAE.title": "已实际完成返程",
  "quest.3FAA66240A902BF5.title": "★ 人回来了，订单也带回来了",
  "quest.3FAA66240A902BF5.quest_desc": [
    "完成一次星球着陆、采集和返程，将第一批星球资源带回基地。"
    "回到主世界后手动勾选。每人可领取 1 次随机饰品奖励，每人限领一次。"
  ],
  "quest.69D84A5B93D06E14.title": "火星：工厂的新材料订单",
  "quest.69D84A5B93D06E14.quest_desc": [
    "先在平板里查看火星环境，带好氧气、罐头和返程物资。"
    "采到的粗萨西特可送进工业粉碎机，1 个加工成 2 萨西特锭。升级设备所需的火星材料可以带回基地统一加工。"
  ],
  "quest.46719253B2BFDDAC.title": "水星：高温与铀的远征",
  "quest.46719253B2BFDDAC.quest_desc": [
    "准备适合高温环境的装备、氧气和返程物资，再前往水星。"
    "新生成的水星铀矿统一为工业铀矿，普通开采得到粗铀。铀锭和核燃料球仍需分别加工。"
  ],
  "quest.3E06FEA0CD270905.title": "金星：想建基地，先活下来",
  "quest.3E06FEA0CD270905.quest_desc": [
    "在平板里查看金星的环境与装备要求，准备补给后出发。"
    "想长期停留，可以先建一间小屋，接好电力和氧气，确认能正常呼吸、进食和返程后再扩建。"
  ],
  "task.6F0A7F63F6D5A3ED.title": "已经试过自动固定",
  "quest.7CC728E50033208F.title": "不用反复翻书：自动固定",
  "quest.7CC728E50033208F.quest_desc": [
    "打开任务书，点击右上角的图钉，开启「自动固定」（部分界面写作「自动置顶」）。"
    "关掉任务书，当前可做的任务就会显示在屏幕旁。也可以手动固定某个任务；不想显示时，再取消固定。"
  ],
  "quest.0B3C2132F0F69FD6.title": "蜜蜂部门正式营业",
  "quest.0B3C2132F0F69FD6.quest_desc": [
    "蜂巢满蜜后收集蜂蜜，手工操作时在下方放营火。蜂蜜瓶可按原版配方合成蜂蜜块，用于制作发动机。"
    "自动取蜜可用侦测器检测蜂巢更新，触发朝向蜂巢、装有玻璃瓶的发射器。蜜量不足时不会装瓶。"
    "满蜜瓶可能留在发射器里，分拣时保留空瓶。先检查装瓶、收集和补瓶能否循环，再多放几组。"
  ],
  "quest.493A52F8760D81FA.title": "骨粉订单：先做小的",
  "quest.493A52F8760D81FA.quest_desc": [
    "粉碎机：1 骨头→6 骨粉，9 骨粉可合成 1 骨块。"
    "骨头可以来自现有刷怪设施、刷怪笼或狩猎，堆肥也能补充骨粉。"
    "先接一个收集箱，之后按用量增加自动供料。"
  ],
  "task.648BB36CA79D624E.title": "已完成一次正确的自动合成",
  "quest.2E2B9AF215675A16.title": "让原版合成器分担一点活",
  "quest.2E2B9AF215675A16.quest_desc": [
    "原版合成器需要红石脉冲触发。用漏斗补料，在界面关闭不使用的格子，再试一次合成。"
    "浓缩小麦、骨块或蜂蜜块任选一种。先放慢触发速度，确认补料后还能做出正确的东西。"
    "装配机的合成也需要原版合成器，可以趁现在一起准备。"
  ],
  "chapter.03E93795A9A740B0.title": "悬赏板：去做点平时没做过的",
  "task.4FA96B8AB7CBB458.title": "了解一次性奖励规则",
  "quest.0D15D4AEB157A45A.title": "奖励规则先看一眼",
  "quest.0D15D4AEB157A45A.quest_desc": [
    "这里有摄影、钓鱼、养蜂、运输和远征挑战，可以挑喜欢的做。"
    "单星挑战奖励 1 次抽奖，双星首领挑战奖励 2 次。奖池为 15 种等概率饰品，可能重复；每人每项挑战只能领取一次。"
    "需要手动勾选的任务，完成后再确认。本章只检查持有，不收走照片、鱼或装备。"
  ],
  "task.48E4ADE26C9331D7.title": "三种主题照片已拍好并整理",
  "quest.1A761D5F232A22ED.title": "★ 摄影部：基地开张纪念册",
  "quest.1A761D5F232A22ED.quest_desc": [
    "拍摄、冲洗并打印至少 3 张不同的照片：工厂、同行的朋友、喜欢的风景。准备相册，把照片整理展示。"
    "任务只检查照片数量和相册，主题完成后再手动勾选。同一张照片复制多份不计入这次挑战。"
  ],
  "task.56D1BE45D7063AB9.title": "取蜜与收集循环已试运行",
  "quest.795734FACEAFF470.title": "★ 蜂场部：首批登月胶料",
  "quest.795734FACEAFF470.quest_desc": [
    "让蜂场完成一次补充玻璃瓶、自动取蜜和收集的循环，再攒够 4 个蜂蜜块。"
    "给蜜蜂留好花和活动空间。蜂蜜块可以继续用于制作火箭发动机。"
  ],
  "quest.59EDB0BEA887323C.title": "★ 钓鱼部：骨粉与照片赞助商",
  "quest.59EDB0BEA887323C.quest_desc": [
    "钓鱼取得 16 个鱼骨，把其中一份加工成骨粉，送给农场或用于摄影胶卷。"
    "任务只检查持有鱼骨和骨粉，不需要消耗收藏鱼或稀有鱼。"
  ],
  "task.3DA7F924B6985DFC.title": "货物已经完成实际运输",
  "quest.3F89A077440277D2.title": "★ 运输部：第一份跨基地订单",
  "quest.3F89A077440277D2.quest_desc": [
    "用船或马车运一次材料，从农场到工厂，或从港口到基地。准备至少 16 生物钢，作为货物或交付成果。"
    "在终点放一个装卸箱。材料会自动检测，实际运完后再手动确认。"
  ],
  "quest.3D8FD0C8C39BDAEA.title": "★ 天境部：探险玩家的工业订单",
  "quest.3D8FD0C8C39BDAEA.quest_desc": [
    "从天境带回 2 气凝胶和 1 神炼重力晶矿，再拍一张探险照片。"
    "气凝胶能做氧气罐，神炼重力晶矿能做工业合金或装备，带回后可与队友分配。"
  ],
  "task.1956FB1326E9C39F.title": "月面照片已带回基地",
  "quest.3C3958182528DB29.title": "★ 远征部：月球相册",
  "quest.3C3958182528DB29.quest_desc": [
    "登月并返回基地，带回至少 8 粗戴斯，再整理一张月面照片。"
    "材料和照片准备好后手动勾选，领奖不会消耗照片。"
  ],
  "task.4BA0C0D48B56C2CE.title": "三条供料或加工线都已运行",
  "quest.6898A0573027B06F.title": "★ 工程部：三条小机器一起上班",
  "quest.6898A0573027B06F.quest_desc": [
    "让木炭供料、小麦加工和骨粉加工各完成一次进料、加工、出料循环。已有农场和机器可以直接使用。"
    "备好 16 塑料片和 4 通量门，检查三条线能否继续供料，再手动确认。"
  ],
  "quest.3DF3039C86BD7AE3.title": "★★ 天境三王：再来一次团队挑战",
  "quest.3DF3039C86BD7AE3.quest_desc": [
    "分别击败一次滑行魔石、女武神女王和烈阳巨灵，按各自机制准备武器与补给。"
    "任务记录开放后的新击杀，之前的战绩不追溯；同队玩家完成击杀可共享进度。"
    "这是可选挑战，不影响工业和航天推进。完成后，每人可领取 2 次随机饰品奖励。"
  ],
  "reward_table.54395DB045051FAC.title": "探险纪念奖：随机实用饰品",
  "chapter.117FBAF175F8BE97.title": "天境远征：云上寻宝，回家开工",
  "quest.2EB9F2D3D7F90AA8.title": "这次，往门里倒水",
  "quest.2EB9F2D3D7F90AA8.quest_desc": [
    "用萤石搭出下界门形状的框架，往框内倒水，即可开启天境门户；已有门户直接使用。"
    "进入天境后完成任务。掉出天境会返回主世界，落点可能很高，提前准备缓降、滑翔或接水的办法。"
  ],
  "quest.03272F6394217382.title": "不懂的东西，先塞进这本书",
  "quest.03272F6394217382.quest_desc": [
    "制作《天境传说》，将天境物品放进查询槽，查看它的作用。"
    "物品用途和特殊机制查这本书，制作配方用配方查看器，探索顺序可以参考本章任务。"
  ],
  "quest.7D3CF7556CE4E296.title": "找一只会帮你跳的兔子",
  "quest.7D3CF7556CE4E296.quest_desc": [
    "在天境找到天跃兔，空手右键互动。它能增强跳跃并减缓下落。"
    "任务会在互动后完成。带它跨岛前，先在平台上试一下跳跃和落地。"
  ],
  "quest.53A6C690B6639E0C.title": "主世界神装，也该配一把当地镐",
  "quest.53A6C690B6639E0C.quest_desc": [
    "先制作天根木镐，再升级圣石、紫晶或重力晶镐。天境有自己的采掘规则，需要使用合适的工具。"
    "列表里任意一把天境镐都能完成任务，已经持有高级镐也可以。"
  ],
  "task.608F461CCBC9C564.title": "任意一把天境镐",
  "quest.300F15B172302717.title": "多一格装备，多一点底气",
  "quest.300F15B172302717.quest_desc": [
    "制作或找到一种天境护手，放进对应的饰品栏，获得额外攻击能力。"
    "持有任意一种即可完成任务，不会收走物品。护手用饰品位置，不占普通护甲格。"
  ],
  "task.749198B627E8F22F.title": "任意一种天境护手",
  "quest.1004B9759DF5E516.title": "神能晶片，先留给机器吃",
  "quest.1004B9759DF5E516.quest_desc": [
    "神能晶矿会掉落神能晶片，可作为神能炉燃料，也能制作天境火把。"
    "普通火把在天境会失效，出门前换成当地火把。神能晶片还可以食用，记得给神能炉留一些。"
  ],
  "quest.194687512BAF8697.title": "紫晶：天境的中间档",
  "quest.194687512BAF8697.quest_desc": [
    "采集紫晶宝石，制作紫晶工具、护甲和神能炉。"
    "升级镐后再去找重力晶矿，顺便补充备用工具和照明。"
  ],
  "quest.590DAD80C67175AF.title": "神能炉：这不是普通熔炉",
  "quest.590DAD80C67175AF.quest_desc": [
    "制作神能炉，放入神能晶片作为燃料。它能处理天境材料，也能修复部分装备。"
    "在配方查看器里查看神能炉页签，确认目标物品的输入和加工方式。"
  ],
  "quest.1806262917C275E8.title": "会往上跑的矿，先封住出口",
  "quest.1806262917C275E8.quest_desc": [
    "用合适的天境镐采集重力晶矿。矿石会向上浮，挖掘前留意头顶空间。"
    "采到的原矿要用神能炉处理，普通熔炉不能完成这一步。"
  ],
  "quest.5025EB0DBB15BC5E.title": "把粉色矿石炼成主力材料",
  "quest.5025EB0DBB15BC5E.quest_desc": [
    "把重力晶矿放进神能炉，用神能晶片加工成神炼重力晶矿。"
    "它能做重力晶装备，也能与镍一起加工精镍锭，按需要给装备和工业分别留料。"
  ],
  "quest.5DB812D7D93A869A.title": "石头能吃，战前别忘了备药",
  "quest.5DB812D7D93A869A.quest_desc": [
    "圣石放进神能炉，可以加工成治愈之石。使用后获得再生效果。"
    "回复有一个过程，适合躲开攻击后恢复生命，去地牢前可以带上一些。"
  ],
  "quest.108E22B911C0AB02.title": "把路边蓝莓升级成口粮",
  "quest.108E22B911C0AB02.quest_desc": [
    "用神能炉加工蓝莓，得到神饯蓝莓。想长期供应，可以在基地种一片蓝莓。"
    "这是可选的食物支线，不影响地牢任务。"
  ],
  "quest.446F0D73FF21165D.title": "冷冻器：把低温变成产品",
  "quest.446F0D73FF21165D.quest_desc": [
    "采集冰石，制作冷冻器。冰石可作为燃料，用来处理水、冰等冷冻配方。"
    "先在配方查看器里找到需要的产物，再放入对应材料。"
  ],
  "quest.238A26DA9C8FAD66.title": "可选：礼物里也可能有惊吓",
  "quest.238A26DA9C8FAD66.quest_desc": [
    "天境偶尔会生成节日树和礼物，部分礼物打开时会爆炸。"
    "从中收集一个姜饼人即可。这是可选收藏，不影响材料和地牢任务。"
  ],
  "quest.015BFDF54AEB70D8.title": "可选：打怪还能掉糖",
  "quest.015BFDF54AEB70D8.quest_desc": [
    "拐杖糖剑是礼物相关的稀有战利品，攻击时有机会产生拐杖糖。"
    "找到一把即可完成这个收藏任务，不影响科技进度。"
  ],
  "quest.38B7C7DBBC6EEFA9.title": "可选：把蓝色跳跳怪变成肥料",
  "quest.38B7C7DBBC6EEFA9.quest_desc": [
    "击败天蓝史维特，取得史维特球，可用于催长天境植物和其他制作。"
    "史维特会包住或弹飞玩家，交战时尽量远离悬崖。能否代替配方里的黏液球，以配方查看器显示为准。"
  ],
  "quest.2FBF8E8A12E1B0EF.title": "可选：金色树木也有材料",
  "quest.2FBF8E8A12E1B0EF.quest_desc": [
    "找到金橡树，用紫晶斧或重力晶斧采集金橡原木，取得金琥珀。"
    "带些树苗回基地种植，以后就有固定的琥珀来源。"
  ],
  "quest.1879BAC8C783B907.title": "可选：先试试远程打法",
  "quest.1879BAC8C783B907.quest_desc": [
    "用金琥珀等材料制作金飞镖和金飞镖发射器，两样都要携带。"
    "神能炉还能制作相关升级。带进地牢前，可以先试射，熟悉射程和弹药用量。"
  ],
  "quest.468831441BD4A5F5.title": "脚下这团云，真能踩",
  "quest.468831441BD4A5F5.quest_desc": [
    "收集寒风境云、天蓝境云或金黄境云中的任意一种，试试不同云的移动效果。"
    "部分云会把玩家弹起，先在平台上测试。"
  ],
  "task.543BBF5DB52AC537.title": "任意一种境云",
  "quest.3D25E86E2AE0E7D6.title": "跳之前，先带降落伞",
  "quest.3D25E86E2AE0E7D6.quest_desc": [
    "制作或找到一种天境降落伞，在安全高度试着使用。"
    "降落伞有使用次数限制，跨岛前检查剩余耐久。"
  ],
  "task.6C3DF395A0C76DA2.title": "任意一种天境降落伞",
  "quest.6BABBE79B9015B40.title": "青铜地牢：这次用镐打首领",
  "quest.6BABBE79B9015B40.quest_desc": [
    "青铜地牢入口常在岛屿侧面，内部有伪装方块和敌人。找到滑行魔石并击败它。"
    "用镐攻击首领，剑不能造成有效伤害。观察它的冲撞方向，留出躲闪空间。"
    "任务读取原版击败进度，以前的记录也能识别。胜利后用青铜钥匙开宝箱，钥匙用掉不影响任务。"
  ],
  "quest.768AF49CDBA57E68.title": "白银地牢：带十枚勋章赴约",
  "quest.768AF49CDBA57E68.quest_desc": [
    "找到武神族神庙，挑战普通武神，收集 10 枚胜利奖牌，再与武神女王交谈，发起挑战。"
    "带好回复用品和照明，留出躲避与撤退的空间。"
    "任务读取原版击败进度；白银钥匙用于开宝箱，用掉后仍能完成任务。"
  ],
  "quest.188901374A2DC9E5.title": "黄金地牢：把冰弹还给它",
  "quest.188901374A2DC9E5.quest_desc": [
    "寻找长有金橡树的高空球形岛屿，找到烈阳巨灵，交谈后挑战。"
    "将它射出的冰弹打回去，才能对它造成伤害。战斗时留意火焰和脚下的平台。"
    "任务读取原版击败进度，以前的记录也能识别。胜利后用黄金钥匙开宝箱。"
  ],
  "quest.146270121F6DB43F.title": "可选：探险家的软糖",
  "quest.146270121F6DB43F.quest_desc": [
    "史维特果冻可以从地牢战利品中获得，找到任意一种即可。"
    "它能回复较多饥饿值，可以留作远征食物。"
  ],
  "task.1F61E21D47FC5847.title": "任意一种史维特果冻",
  "quest.73D4BA2D24BA5C82.title": "可选：口袋里装一点回复",
  "quest.73D4BA2D24BA5C82.quest_desc": [
    "再生之石来自白银地牢，放在身上能缓慢恢复生命。"
    "回复速度有限，战斗时仍要躲避攻击。"
  ],
  "quest.62DB484A8F57D82E.title": "可选：多一颗心，也要先活着回来",
  "quest.62DB484A8F57D82E.quest_desc": [
    "生命补片是黄金地牢的稀有战利品，使用后永久增加 1 颗红心，使用上限由天境配置决定。"
    "取得物品即可完成任务，可以之后再用。"
  ],
  "quest.43399D59D35BB2BA.title": "日轮祭坛：把白昼收进背包",
  "quest.43399D59D35BB2BA.quest_desc": [
    "击败烈阳巨灵后取得日轮祭坛，可用它调整天境的昼夜时间。"
    "多余祭坛还能通过宝藏重铸熔炼回收，记得留一座用于调时间。"
  ],
  "quest.60ACFEDD64794D70.title": "可选：把天境的唱片带回家",
  "quest.60ACFEDD64794D70.quest_desc": [
    "天境共有 5 张隐藏唱片，来源包括地牢战利品、神能炉和冷冻器加工。"
    "查看对应唱片的配方与来源，慢慢收集即可，不影响工业或首领任务。"
  ],
  "quest.7D6BBA4E9F3885A2.title": "宝藏重铸：重复海皇装备别扔",
  "quest.7D6BBA4E9F3885A2.quest_desc": [
    "多余的海皇装备可以放进普通熔炉，每件回收成 1 个海皇织物。"
    "先把正在使用的装备留好。任务只检查织物，不会收走。"
  ],
  "quest.4CEF6AA48D4D61FC.title": "宝藏重铸：武神装备变原料",
  "quest.4CEF6AA48D4D61FC.quest_desc": [
    "重复的武神盔甲、护手、长枪或工具可以放进普通熔炉，每件回收成 1 个武神金属锭。"
    "金属锭可用于重铸装备、工业外骨骼胸甲、基础喷气背包，也能加工成杜拉锭。"
    "材料可以交易，青铜地牢里的武神长枪也能回收，不必每个人都去打武神女王。"
  ],
  "quest.2331125BB6CA4E15.title": "宝藏重铸：凤凰套装也能回收",
  "quest.2331125BB6CA4E15.quest_desc": [
    "多余的凤凰盔甲或护手可以放进普通熔炉，每件回收成 1 个烈金锭。"
    "用回收的材料按锻造配方补齐缺少的部位。"
  ],
  "quest.22B7DA7D1DD82B48.title": "多余祭坛，也有去处",
  "quest.22B7DA7D1DD82B48.quest_desc": [
    "1 个日轮祭坛可在普通熔炉中熔炼成 1 个烈金碎片；4 碎片＋2 黑曜石可合成 1 烈金锭。"
    "留一座祭坛用于调时间。碎片还可重新点燃黑曜石盔甲，用法见《天境传说》。"
  ],
  "quest.3A022E638421A6BC.title": "缺海皇部位？自己补一件",
  "quest.3A022E638421A6BC.quest_desc": [
    "锻造台：海皇升级锻造模板＋对应紫晶装备＋海皇织物→海皇装备。"
    "第一张模板从地牢战利品获取，之后可以复制。拿到模板即可完成任务；装备做好后，可在水池里试试水下能力。"
  ],
  "quest.39AD1DA7BC089580.title": "武神镐：不用再赌重复掉落",
  "quest.39AD1DA7BC089580.quest_desc": [
    "锻造台：武神升级锻造模板＋重力晶镐＋武神金属锭→武神镐。其他部位换成对应的重力晶装备。"
    "模板复制配方：7 块神炼重力晶矿＋1 块天灵石＋原模板→2 张模板。第一张需要从宝箱中取得。"
  ],
  "quest.619639ED3C99F9D8.title": "凤凰胸甲：把多余材料穿起来",
  "quest.619639ED3C99F9D8.quest_desc": [
    "锻造台：凤凰升级锻造模板＋重力晶胸甲＋烈金锭→凤凰胸甲。"
    "第一张模板从地牢战利品获取，拿到后可以复制。其他部位也有对应配方，先做缺少的即可。"
  ],
  "quest.5C1B9E8BC57D2AE3.title": "云上的矿，交给地上的炉",
  "quest.5C1B9E8BC57D2AE3.quest_desc": [
    "铸造炉：1 神炼重力晶矿＋1 镍锭→2 精镍锭。"
    "准备好一份天境原料和两份成品即可完成，任务不收走材料。"
  ],
  "quest.24D42B62E24A0284.title": "武神金属，不只用来做盔甲",
  "quest.24D42B62E24A0284.quest_desc": [
    "铸造炉：1 武神金属锭＋1 铂锭→1 杜拉锭。"
    "武神金属既能补装备，也能供工业使用，回收重复战利品后按需要分配。"
  ],
  "quest.061E5DAA5477478B.title": "下一站太空，氧气罐先做好",
  "quest.061E5DAA5477478B.quest_desc": [
    "装配机：2 钢锭＋1 气凝胶＋1 塑料片→1 大型氧气罐。"
    "气凝胶来自天境，塑料由工业加工取得。做好罐子后充氧，再去「航天远征」章节准备其他装备。"
  ],
  "quest.4708A57C29450F13.title": "三座地牢：带着故事回基地",
  "quest.4708A57C29450F13.quest_desc": [
    "完成青铜、白银、黄金三种地牢的首领击败进度，可领取 1 次随机饰品抽奖。"
    "不需要交出钥匙，也不用收齐地牢宝藏。重复的装备可以留着重铸或加工工业材料。"
  ],
  "task.30C75105BF1F6371.title": "与一只天跃兔互动",
  "chapter_group.1F9E64CA2F74F2AC.title": "我们的村庄：从一句你好开始",
  "chapter.0C34DFF90D2950EB.title": "先和邻居聊两句",
  "quest.54FFCF66C353F783.title": "这次，他真的能接话",
  "quest.54FFCF66C353F783.quest_desc": [
    "右键成年村民，打开互动菜单。村民各有名字、性格和好感，可以聊天、送礼，也能使用跟随等功能。"
    "想和他用中文聊天，靠近后按 T，在普通聊天栏输入「Alex，你好」，将 Alex 换成对方的名字。"
    "先问一句，再接着追问。没接上时，重新带名字喊一次；尽量靠近，别同时喊几位村民。"
    "和同一位村民完成一次问答，再追问一句，手动勾选即可。"
    "聊天内容不会直接执行盖房、送货等游戏操作；需要这些动作时，用互动菜单。没有回应，可以请主机检查 AI 服务和网络。"
  ],
  "task.2F1348EA932DCD06.title": "完成上述步骤后，点击勾选确认",
  "quest.2FC50895E45969F5.title": "聊得来，就多来往",
  "quest.2FC50895E45969F5.quest_desc": [
    "在互动菜单里试试送礼、跟随、停留、安家和回家。礼物可以先送一份，看看对方反应；结婚、生孩子不属于本任务要求。"
    "村民朗读默认关闭，按 F6 可切换自己听到的语音，中文文字聊天照常使用。改键位置：「选项 → 控制 → 按键绑定 → Better MC」。"
    "试过菜单和语音开关后，手动勾选，语音留在自己喜欢的状态即可。"
  ],
  "task.60D4FD91E6365E5F.title": "完成上述步骤后，点击勾选确认",
  "chapter.6B48A19885CA3DC8.title": "基地旁边，慢慢长出一个村庄",
  "quest.1BBF337AF167F38B.title": "村长先学看蓝图",
  "quest.1BBF337AF167F38B.quest_desc": [
    "制作一张 MCA 蓝图，配方在物品查看器里查询。持有即可完成，不收走蓝图。"
    "右键打开，看看地图、建筑目录和高级页面。建筑目录列出了各种建筑的识别要求，动工前先查这里。"
    "蓝图用来登记、管理建筑，房子需要玩家自己盖。已有基地和旧房屋也能登记。"
  ],
  "task.383DDBD3751B875A.title": "取得一张蓝图（不消耗）",
  "quest.40B23EA6BFDD515F.title": "这栋房子终于有地址了",
  "quest.40B23EA6BFDD515F.quest_desc": [
    "选一间有屋顶、门和通行空间的房间。站在屋内打开蓝图，在地图页点击「添加建筑」，查看识别结果。"
    "没识别成功时，检查门、屋顶、房间边界和已有建筑是否重叠。提示范围过大，就先登记一间独立小屋；多房间建筑需要逐一查看扫描结果。"
    "成功登记一间房，并能在蓝图里找到它后，手动勾选。"
  ],
  "task.0E61DDE0CB737ABE.title": "完成上述步骤后，点击勾选确认",
  "quest.0FF560FE608DAAE3.title": "我的卧室，请勿占床",
  "quest.0FF560FE608DAAE3.quest_desc": [
    "已有基地可以继续住。MCA 蓝图不能给玩家分配住宅，复活点仍按床等原版规则设置。"
    "想给自己留一间卧室，可以站在房间里，打开蓝图高级页，选择「限制访问」。多房间建筑要分别检查。"
    "这个设置阻止村民搬入，不会锁门，村民仍可能路过。需要与家人共享的房间可以保持开放。"
    "设置好限制，或决定保留共享后，手动勾选。"
  ],
  "task.70FC748AFCA81C7D.title": "完成上述步骤后，点击勾选确认",
  "quest.1DFFB0FAEAFFBEFD.title": "隔壁终于有人住了",
  "quest.1DFFB0FAEAFFBEFD.quest_desc": [
    "准备一间有床、能进出的房子，用蓝图登记。旧房改造或新建都可以。"
    "让村民跟随进屋，在互动菜单选择「安家此地」。结束跟随后，用「回家」检查它能否走回住处。"
    "走不回去时，检查门、台阶、床边空间和沿路障碍，也看看房间是否设了限制访问。"
    "安排好至少一位村民的住处，并确认能正常回家后，手动勾选。"
  ],
  "task.1D2C71074766117A.title": "完成上述步骤后，点击勾选确认",
  "chapter.4BDE6A29DEAEBF91.title": "今晚有人留宿",
  "quest.4054B1E1B5BEA909.title": "四张床，一间小旅馆",
  "quest.4054B1E1B5BEA909.quest_desc": [
    "在蓝图目录查看旅馆要求：4 张床、1 个唱片机、1 个烟熏炉，放进同一个可识别的建筑空间。"
    "给床和入口留出通路，登记或更新建筑。蓝图识别为旅馆后，手动勾选，不用等客人入住。"
    "没有识别成旅馆时，检查房间结构，以及所有设施是否都在扫描范围内。"
  ],
  "task.2EDA0B35F521323C.title": "完成上述步骤后，点击勾选确认",
  "quest.4E78AD71CE0BC6FB.title": "客人来了，饭在哪",
  "quest.4E78AD71CE0BC6FB.quest_desc": [
    "在旅馆准备一个补给角，放上食物、火把和备用工具，并标明箱子的用途。可以手动补货，也能接现有农场。"
    "这些补给供你和朋友使用，村民不会从普通箱子里自动取食。"
    "补给准备好后，手动勾选。"
  ],
  "task.0C9C567C613ACA51.title": "完成上述步骤后，点击勾选确认",
  "quest.3716A6A059A9EFD8.title": "门前这条路，终于有用了",
  "quest.3716A6A059A9EFD8.quest_desc": [
    "修一条连接基地、住宅和旅馆的路，沿途放好照明，填平深坑，危险落差处加台阶。"
    "带村民走一次，再结束跟随，让它回家。遇到它走不过去的地方，补成平路或台阶。"
    "道路能通行、有照明，并完成一次跟随或回家测试后，手动勾选。"
  ],
  "task.36C753814609D98E.title": "完成上述步骤后，点击勾选确认",
  "chapter.15369A141060F37C.title": "钓鱼协会：十种鱼，开一次奖",
  "quest.36B88B95F4332B19.title": "鱼可以带走，登记得留一条",
  "quest.36B88B95F4332B19.quest_desc": [
    "本章收录 106 种鱼：潮汐新增 102 种，加上 4 种原版鱼。每种提交 1 条生鱼，不收熟鱼、鱼桶或鱼肉片。"
    "带鱼打开对应任务，点击鱼图标提交，会消耗 1 条；放进背包不会自动交鱼。同一种只登记一次，旧收藏也能交，大小不限。"
    "每累计 10 种不同的鱼，就能领取下一档抽奖，直到 100 种。达到数量后打开对应里程碑，点击勾选，再领取右侧随机奖励。每档限领一次，15 种饰品等概率，可能重复。"
    "钓点、深度、时间和天气可查鱼类图鉴。只有实际提交的鱼才计数，解锁图鉴不算。"
  ],
  "quest.77ED85FA5985B568.title": "淡水 · 鲑鱼",
  "quest.77ED85FA5985B568.quest_desc": [
    "提交 1 条鲑鱼。点击鱼图标交鱼，会消耗这条鱼；每种鱼只登记一次。"
    "钓点和出没条件可在鱼类图鉴中查看。"
  ],
  "task.7B16CC6AD52CC806.title": "提交 1 条鲑鱼（消耗）",
