  ],
  "task.55C4DC669E53B52F.title": "达到提交数量后，点击确认并领取奖励",
  "chapter_group.6746CC9A38470A04.title": "终极任务：远征之星",
  "chapter.62AEA55A8241D006.title": "九核归一：我们的远征之星",
  "quest.648C07D0EB34487E.title": "把各自擅长的，拼成一颗星",
  "quest.648C07D0EB34487E.quest_desc": [
    "先完成工业、天境、星际、原版、潮汐和生活六个核心，材料可以分工收集。"
    "最终还会加入三个核心。目前远征之星已有测试能力，但尚不能在生存模式合成，任务也不会发放。"
    "本章检测核心时不消耗物品。工业压缩件可在工作台制作，按 G 查看配方。"
  ],
  "quest.6CB9011C61A66828.title": "工业核心",
  "quest.6CB9011C61A66828.quest_desc": [
    "先把材料压缩成组件，再到工作台组装工业核心。"
    "压缩前的外层用量：162 杜拉、81 精镍、81 有机钢、9 辐镍晶、9 超级 AI、9 过充水晶、81 强化碳板、9 高级电池。"
    "如果杜拉走原子炉、超导体走装配机、电池走酸液批量配方，连同内部材料共需：171 杜拉、423 强化碳板、108 有机钢、94 精镍、27 处理器、36 晶圆、27 高级电池。电池做 4 批产 32 个，剩 5 个；建厂材料另算。"
    "423 碳板会消耗 211.5 桶石脑油。可以先完成左侧的分批备料任务，再扩充板材加工和激光供能。"
    "以上是这组工艺的用量参考，换配方后数量会变。合成核心不额外要求核电、粒子加速器或高级装备。"
    "普通工业压缩件可在工作台拆回 9 份下一级材料。高能计算组件和储能晶体组件需要潜行右键空气拆解，返还材料会自动分堆；背包放不下时不拆。核心本体不能拆解。"
  ],
  "quest.6693FB6F4F2C7EC7.title": "天境核心",
  "quest.6693FB6F4F2C7EC7.quest_desc": [
    "工作台九格各放一份：附魔重力晶、紫晶块、气凝胶、神能晶块、武神金属锭、黄金琥珀、海皇织物、烈金锭、生命补片。"
    "不需要地牢钥匙。具体物品与排列按 G 查看。"
  ],
  "quest.6571D5A2D79527FD.title": "星际核心",
  "quest.6571D5A2D79527FD.quest_desc": [
    "收集月球、火星、金星和水星的材料，再制作放射性发动机。"
    "工作台各放一份：戴斯锭、铊石锭、科洛尼锭、月果、放射性发动机、火星果、索莱尼、水星岩、金星岩。"
    "这份配方不需要前往木星。"
  ],
  "quest.6CE2C39050644CC1.title": "生活核心",
  "quest.6CE2C39050644CC1.quest_desc": [
    "在同一个 MCA 村庄里，完成下方列出的 10 类特殊建筑，即可领取生活核心。"
    "房屋由玩家建造或改造，再用蓝图登记，确认识别类型。十类建筑需要同时保留在同一村庄中，队友可以分头建设。"
    "摄影不属于领取条件。"
  ],
  "quest.64CB9EEFC50996FA.title": "原版核心",
  "quest.64CB9EEFC50996FA.quest_desc": [
    "在工作台各放一份：附魔金苹果、海洋之心、回响碎片、凋灵骷髅头颅、下界之星、龙息、下界合金块、重核、嗅探兽蛋。"
    "已有物资和工业替代来源都能使用，不需要消耗龙蛋。"
  ],
  "quest.6E73047E36C0AABF.title": "潮汐核心",
  "quest.6E73047E36C0AABF.quest_desc": [
    "工作台各放一条：腔棘鱼、龙鱼、流星、魔鳉、始祖鱼、虚空寻觅者、点金鱼、大白鲨、烈焰剑鱼，共 9 种生鱼。"
    "前七种是传说鱼，钓点条件可查鱼类图鉴。留意满月、夜雨、深海、地下水域和幸运值；虚空、熔岩钓鱼还需要对应钓具能力。"
    "鱼桶和熟鱼不能代替。已经在收集任务中提交的鱼不会返还，做核心时要另外准备。"
  ],
  "quest.6E19564879D3A25F.title": "蓝图建造：军械库",
  "quest.6E19564879D3A25F.quest_desc": [
    "准备锻造台×1、砂轮×1、铁砧×1，放进一间可识别的房屋。"
    "建好后在屋内用蓝图登记，确认类型为「军械库」。已有房屋可以改造。"
  ],
  "quest.6F2023EF5BC54534.title": "蓝图建造：大住宅",
  "quest.6F2023EF5BC54534.quest_desc": [
    "在房屋里放至少 4 张床，给床边和入口留出通路。"
    "用蓝图登记，确认类型为「大住宅」。其他功能设施尽量分房间布置，免得识别成别的建筑。"
  ],
  "quest.66A729151A4A5D91.title": "蓝图建造：铁匠铺",
  "quest.66A729151A4A5D91.quest_desc": [
    "在房屋里放砂轮×1、高炉×2、铁砧×1，用蓝图登记为「铁匠铺」。"
    "可以改造厂区里的旧房。工业机器可以一起摆，但不能代替这几种功能方块。"
  ],
  "quest.63E05F70449D310C.title": "蓝图建造：墓园",
  "quest.63E05F70449D310C.quest_desc": [
    "准备 3 块 MCA 墓碑，布置一处室外墓园。"
    "用蓝图按室外区域登记，确认类型为「墓园」。"
  ],
  "quest.6736A05E69116840.title": "蓝图建造：医务室",
  "quest.6736A05E69116840.quest_desc": [
    "在房屋里放酿造台×1、炼药锅×1、床×1、花盆×1。"
    "用蓝图登记为「医务室」，确认这些设施都在扫描范围内。"
  ],
  "quest.6F5BA0B6541B0AE5.title": "蓝图建造：旅馆",
  "quest.6F5BA0B6541B0AE5.quest_desc": [
    "在房屋里放床×4、唱片机×1、烟熏炉×1，留出通行空间。"
    "用蓝图确认识别为「旅馆」。已经建好的旅馆可以直接使用。"
  ],
  "quest.6ED948B951FDE657.title": "蓝图建造：图书馆",
  "quest.6ED948B951FDE657.quest_desc": [
    "准备普通书架×32、讲台×1，布置进同一间可识别的建筑。"
    "用蓝图登记为「图书馆」。注意是普通书架，其他装饰书架不一定计数。"
  ],
  "quest.65E4F4E3F2CFFFEC.title": "蓝图建造：音乐商店",
  "quest.65E4F4E3F2CFFFEC.quest_desc": [
    "在房屋里放唱片机×1、音符盒×2、箱子×1。"
    "用蓝图登记为「音乐商店」。可以顺便摆上收集到的唱片。"
  ],
  "quest.6FBB815269A5849A.title": "蓝图建造：监狱",
  "quest.6FBB815269A5849A.quest_desc": [
    "在房屋里放铁栏杆×8、铁门×1、床×1。"
    "用蓝图登记为「监狱」，检查设施是否都在扫描范围内。"
  ],
  "quest.61F12EE65A6A93B7.title": "蓝图建造：仓库",
  "quest.61F12EE65A6A93B7.quest_desc": [
    "在房屋里放讲台×1、箱子×4，用蓝图登记为「仓库」。"
    "已有储物间可以改造。建好后确认识别类型，避免被其他设施识别成别的建筑。"
  ],
  "quest.690C443580B5C326.title": "把村庄真正建起来",
  "quest.690C443580B5C326.quest_desc": [
    "在同一个 MCA 村庄内保留上述 10 类建筑，用蓝图确认每一类都已登记。"
    "站在村庄范围内等几秒，系统每 5 秒检查一次。墓园按室外区域登记，普通房屋与隐藏职业标记不计入这 10 类。"
    "完成后全队共领 1 个生活核心。不需要拍照、结婚生子或累计聊天次数。"
  ],
  "quest.6966B2AABB041E8A.title": "远征之星：九核归一",
  "quest.6966B2AABB041E8A.quest_desc": [
    "你真牛逼.哪来的远征之星..开创了吧？"
  ],
  "quest.67A4937AC79F5D9A.title": "先做硅，再把水接进来",
  "quest.67A4937AC79F5D9A.quest_desc": [
    "先将石英粉碎成石英粉。工作台用 2 石英粉＋2 沙合成 3 粗硅，再熔炼成硅。"
    "6 铜锭＋3 硅可做 6 根流体管道。流体插件需要碳纤维、琥珀金、硅和管道，完整配方按 G 查看。"
    "插件装到离心机接口上，水管接机器本体。接好水源和抽水设备，就能做湿式加工。"
  ],
  "quest.674A67BF2E08C9B1.title": "田里的材料，也能做处理器",
  "quest.674A67BF2E08C9B1.quest_desc": [
    "装配机放入塑料片、碳纤维、有机钢、比较器各 1 份，得到 1 处理器。"
    "小麦能加工成生物材料，木炭能加工成碳纤维，铁可用于有机钢。比较器还要准备石英和红石。"
    "接下来的激光指示器、磁通门和计算部件都会消耗处理器，可以多备一些。"
  ],
  "quest.6770830691AB521F.title": "先找一份铂，给工厂开门",
  "quest.6770830691AB521F.quest_desc": [
    "主世界深层和末地都有铂矿。采到粗铂后，直接熔炼成铂锭，供初期机器使用。"
    "旧矿区没有工业矿物时，需要去新生成的地形找。先熔炼够用的量，其余粗铂留给后面的增产加工。"
    "取得首批铂不需要碎片锻造炉，也不用等镍团块的副产物。"
  ],
  "quest.671F07BE196FDB61.title": "紫水晶换一种用途",
  "quest.671F07BE196FDB61.quest_desc": [
    "用激光采集成熟紫水晶簇，取得辐水晶。它和处理器、骨块、铂一起用于制作磁通门。"
    "先取一份用于起步。后面完整加工粗铂，也能得到辐水晶副产物。"
  ],
  "quest.6777C602DB47C410.title": "板材车间：把石脑油用起来",
  "quest.6777C602DB47C410.quest_desc": [
    "接好精炼厂顶部模块，将石脑油单独存进储罐。"
    "精炼厂：1 碳纤维＋半桶石脑油→1 强化碳纤维板，当前基础加工时间为 16 秒。"
    "普通精炼厂不能直接安装速度插件，需要增产时可多建几台。板材加工与原油分馏分开用机器，省得反复换料。"
    "按杜拉原子加工配方计算，一份工业核心共需 423 块强化碳板。"
  ],
  "quest.67961B905E6690BA.title": "电池别一颗一颗手搓",
  "quest.67961B905E6690BA.quest_desc": [
    "在装有流体插件的离心机中，可疑的容器＋酸液可一次制作 8 个高级电池。"
    "容器用 1 塑料＋1 精镍＋4 末影化合物制作；酸液来自炼油，与石脑油分罐储存。"
    "手工配方也能用，每颗需要 1 琥珀金、4 钢、2 辐镍晶。"
    "工业核心及其内部组件共需 27 个高级电池。批量做 4 次得到 32 个，剩下 5 个可留作他用。"
  ],
  "quest.67382BA3F398BEA4.title": "给计算部件切几片晶圆",
  "quest.67382BA3F398BEA4.quest_desc": [
    "精炼厂用石英粉和石脑油制作硅洗液，再送进装有流体插件的离心机。加入碳纤维，一批得到 4 片硅晶圆。"
    "原子炉也能用硅和碳纤维制作晶圆，两条配方都可使用。"
    "每个高级计算引擎需要 2 片晶圆。工业核心的 9 颗超级 AI 共需 36 片，建机器的用量另算。"
  ],
  "quest.67C10EFFD2C2D790.title": "动力房升级：让燃油接班",
  "quest.67C10EFFD2C2D790.quest_desc": [
    "制作燃油发电机，配方需要末影透镜等零件，按 G 查看。接入炼油得到的可用燃料，检查能否连续供料。"
    "基础输出为 256 RF/t，相当于 8 台基础燃煤机。"
    "这份输出可供应两台基础激光，或一台带单个速度插件的激光；同时运行加工机器时，还要加上它们的用电。"
    "普通能量线缆上限为 2048 RF/t。扩建电站时，一并检查线缆与设备输入。"
  ],
  "quest.6754A52536F3CB23.title": "第一块杜拉，先付一笔启动费",
  "quest.6754A52536F3CB23.quest_desc": [
    "铸造炉：1 铂锭＋1 下界合金锭→1 杜拉锭。也可以用 1 武神金属锭替代下界合金锭。"
    "先用这个配方做出原子炉所需的杜拉。原子炉投产后，就能改用铂和强化碳板批量加工。"
  ],
  "quest.67D29FAA41C91DCB.title": "电缆到此为止，接下来用光",
  "quest.67D29FAA41C91DCB.quest_desc": [
    "用杜拉锭、磁通门等材料制作原子炉，按高亮位置安装 8 个核心。"
    "原子炉通过激光接收能量，不能直接接普通电缆。给激光供电，用指示器对准原子炉，清空中间的障碍物。"
    "放入 1 铂锭＋2 强化碳板，充能完成后得到 1 杜拉锭。这里的进度条显示充能过程。"
    "多台激光或速度插件可以提高充能速度，也需要相应的电源。一束基础激光的传输速度不会因换了核电而提高。"
  ],
  "quest.672DC0292BBD0BBC.title": "让处理器长点算力",
  "quest.672DC0292BBD0BBC.quest_desc": [
    "原子炉：1 处理器＋2 硅晶圆→1 高级计算引擎。检查激光能否持续供能，并及时取走成品。"
    "工业核心的 9 颗超级 AI 共需 18 个计算引擎、36 片晶圆；超导体配方里的磁通门也需要处理器。"
    "晶圆和处理器备齐后可以成批加工。"
  ],
  "quest.67DE28B49F6E254D.title": "算力交付：第一颗超级AI",
  "quest.67DE28B49F6E254D.quest_desc": [
    "原子炉：1 杜拉锭＋2 高级计算引擎→1 超级 AI 芯片。"
    "工业核心需要 9 颗芯片。芯片内部消耗 9 杜拉，加上外层的 162 杜拉，主体共需 171 杜拉，建厂用量另算。"
    "可以给计算线留一个备料箱，避免这部分杜拉被其他机器用掉。"
  ],
  "quest.67B25B217D1F8633.title": "四根超导，一批装好",
  "quest.67B25B217D1F8633.quest_desc": [
    "装配机放入磁通门、琥珀金、可疑的容器、辐镍晶各 1 份，一批得到 4 根超导体。辐镍晶可用镍和辐水晶铸造。"
    "9 个过充水晶需要 36 根超导体，正好做 9 批。内部还需 9 个磁通门，对应 9 处理器、9 骨块和 9 铂锭。"
  ],
  "quest.6751864B8F3142F9.title": "先装一颗储能水晶",
  "quest.6751864B8F3142F9.quest_desc": [
    "工作台用 1 紫水晶块＋4 超导体＋2 高级电池合成 1 过充水晶，摆法按 G 查看。"
    "工业核心需要 9 个过充水晶，内部共需 36 超导体和 18 电池。再加电池阵列的 9 颗，一共需要 27 个高级电池。"
    "粒子加速器也有制作工艺，可以按已有设备选择。"
  ],
  "quest.675C7355333030FE.title": "扩建之前，先找谁在排队",
  "quest.675C7355333030FE.quest_desc": [
    "原料断供、机器缺电、输出堵塞，都会影响产量。先找到卡住的那一步，再扩建。"
    "基础激光供能为 128 RF/t，安装单个速度插件后为 256 RF/t；也可以多台激光一起供能。电源要能跟上。"
    "按核心指定工艺计算，单台基础激光完成原子充能理论上约需 232 分钟；8 台基础激光，或 4 台各带一个速度插件的激光，约需 29 分钟。"
    "423 块碳板用单台普通精炼厂约需 113 分钟，4 台约需 28 分钟。以上按 20 刻／秒、不断料不断电估算，未计换料时间。"
    "安排好一项供料、供电或并行加工方案后，手动勾选。"
  ],
  "quest.67A710C61F1D9A65.title": "交付看板：板材先到一批",
  "quest.67A710C61F1D9A65.quest_desc": [
    "备好 16 块强化碳板，检查石脑油、碳纤维、电力和出料是否能继续供应。"
    "按杜拉原子加工配方计算，工业核心共需 423 块碳板，其中 342 用于杜拉，81 用于碳纤维构件，可以分批加工。"
    "本任务只检查持有，不消耗材料。已经有工业核心，可以直接完成核心节点，不用重新备料。"
  ],
  "quest.67E4072BDF2BCC4A.title": "交付看板：杜拉开始成批",
  "quest.67E4072BDF2BCC4A.quest_desc": [
    "备好 16 杜拉，给后续合成留料；建机器的用量另算。"
    "核心主体共需 171 杜拉：162 用于两个致密合金块，9 用于超级 AI。也可以继续用下界合金或武神金属的替代工艺。"
    "电量见底先补供电；电量足够却充能慢，检查激光吞吐。本任务不消耗材料。"
  ],
  "quest.677E3FA80FDC1AEC.title": "交付看板：九颗超级AI到货",
  "quest.677E3FA80FDC1AEC.quest_desc": [
    "准备 9 颗超级 AI，检查完成后再压缩成高能计算组件。检测不消耗芯片。"
    "芯片内部需要 18 高级计算引擎、36 晶圆和 9 杜拉；连同超导体内部的磁通门，核心主体共需 27 处理器。"
    "如果已经压成组件，潜行右键空气可拆回 9 颗芯片，材料会自动分堆放进背包。"
  ]
}
